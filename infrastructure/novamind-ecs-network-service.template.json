{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Opt-in domain-free NovaMind API: private ALB, CloudFront VPC Origin, Fargate service, and least-privilege security groups. It never creates NAT, VPC endpoints, DNS records, certificates, RDS, or public CloudFront origins.",
  "Parameters": {
    "VpcId": {"Type": "AWS::EC2::VPC::Id"},
    "VpcCidr": {"Type": "String", "AllowedPattern": "^[0-9.]+/[0-9]{1,2}$"},
    "ApplicationPublicSubnetIds": {"Type": "List<AWS::EC2::Subnet::Id>"},
    "RdsSecurityGroupId": {"Type": "AWS::EC2::SecurityGroup::Id"},
    "CloudFrontOriginPrefixListId": {"Type": "String", "Default": ""},
    "CreateOriginPrivateSubnets": {"Type": "String", "Default": "false", "AllowedValues": ["true", "false"]},
    "ExistingOriginPrivateSubnetAId": {"Type": "String", "Default": "", "AllowedPattern": "^$|^subnet-[0-9a-f]{8,17}$"},
    "ExistingOriginPrivateSubnetBId": {"Type": "String", "Default": "", "AllowedPattern": "^$|^subnet-[0-9a-f]{8,17}$"},
    "OriginPrivateSubnetAzA": {"Type": "String", "Default": ""},
    "OriginPrivateSubnetAzB": {"Type": "String", "Default": ""},
    "OriginPrivateSubnetCidrA": {"Type": "String", "Default": "0.0.0.0/32", "AllowedPattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(3[0-2]|[12]?[0-9])$"},
    "OriginPrivateSubnetCidrB": {"Type": "String", "Default": "0.0.0.0/32", "AllowedPattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(3[0-2]|[12]?[0-9])$"},
    "CreateLoadBalancerSecurityGroup": {"Type": "String", "Default": "false", "AllowedValues": ["true", "false"]},
    "ExistingLoadBalancerSecurityGroupId": {"Type": "String", "Default": "", "AllowedPattern": "^$|^sg-[0-9a-f]{8,17}$"},
    "CreateApiSecurityGroup": {"Type": "String", "Default": "false", "AllowedValues": ["true", "false"]},
    "ExistingApiSecurityGroupId": {"Type": "String", "Default": "", "AllowedPattern": "^$|^sg-[0-9a-f]{8,17}$"},
    "AddApiIngressFromLoadBalancer": {"Type": "String", "Default": "false", "AllowedValues": ["true", "false"]},
    "AddRdsIngressFromApi": {"Type": "String", "Default": "false", "AllowedValues": ["true", "false"]},
    "ApiHttpsEgressReady": {"Type": "String", "Default": "false", "AllowedValues": ["true", "false"]},
    "EnableApiExternalHttpsEgress": {"Type": "String", "Default": "false", "AllowedValues": ["true", "false"]},
    "CreateInternalApiLoadBalancer": {"Type": "String", "Default": "false", "AllowedValues": ["true", "false"]},
    "ExistingInternalApiLoadBalancerArn": {"Type": "String", "Default": ""},
    "ExistingInternalApiLoadBalancerDnsName": {"Type": "String", "Default": ""},
    "CreateApiTargetGroup": {"Type": "String", "Default": "false", "AllowedValues": ["true", "false"]},
    "ExistingApiTargetGroupArn": {"Type": "String", "Default": ""},
    "CreateInternalApiHttpListener": {"Type": "String", "Default": "false", "AllowedValues": ["true", "false"]},
    "ExistingInternalApiHttpListenerArn": {"Type": "String", "Default": ""},
    "CreateApiService": {"Type": "String", "Default": "false", "AllowedValues": ["true", "false"]},
    "ClusterName": {"Type": "String", "Default": "novamind-crp-ecs-cluster-dev"},
    "ApiServiceName": {"Type": "String", "Default": "novamind-crp-api-dev"},
    "ApiTaskDefinitionArn": {"Type": "String", "Default": ""},
    "ApiContainerName": {"Type": "String", "Default": "backend"},
    "DesiredCount": {"Type": "Number", "Default": 1, "MinValue": 1, "MaxValue": 2},
    "ApiPublicIpEgress": {"Type": "String", "Default": "false", "AllowedValues": ["true", "false"]},
    "CreateCloudFrontVpcOrigin": {"Type": "String", "Default": "false", "AllowedValues": ["true", "false"]},
    "ExistingCloudFrontVpcOriginId": {"Type": "String", "Default": ""},
    "VpcOriginName": {"Type": "String", "Default": "novamind-crp-api-vpc-origin-dev", "AllowedPattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}
  },
  "Rules": {
    "OriginSubnetSource": {"Assertions": [{"Assert": {"Fn::Or": [{"Fn::And": [{"Fn::Equals": [{"Ref": "CreateOriginPrivateSubnets"}, "true"]}, {"Fn::Equals": [{"Ref": "ExistingOriginPrivateSubnetAId"}, ""]}, {"Fn::Equals": [{"Ref": "ExistingOriginPrivateSubnetBId"}, ""]}]}, {"Fn::And": [{"Fn::Equals": [{"Ref": "CreateOriginPrivateSubnets"}, "false"]}, {"Fn::Not": [{"Fn::Equals": [{"Ref": "ExistingOriginPrivateSubnetAId"}, ""]}]}, {"Fn::Not": [{"Fn::Equals": [{"Ref": "ExistingOriginPrivateSubnetBId"}, ""]}]}]}]}, "AssertDescription": "Select exactly one private-subnet source: create two dedicated origin subnets, or provide two existing private subnet IDs."}]},
    "NewOriginSubnetsNeedCidrsAndAzs": {"RuleCondition": {"Fn::Equals": [{"Ref": "CreateOriginPrivateSubnets"}, "true"]}, "Assertions": [{"Assert": {"Fn::And": [{"Fn::Not": [{"Fn::Equals": [{"Ref": "OriginPrivateSubnetAzA"}, ""]}]}, {"Fn::Not": [{"Fn::Equals": [{"Ref": "OriginPrivateSubnetAzB"}, ""]}]}, {"Fn::Not": [{"Fn::Equals": [{"Ref": "OriginPrivateSubnetCidrA"}, "0.0.0.0/32"]}]}, {"Fn::Not": [{"Fn::Equals": [{"Ref": "OriginPrivateSubnetCidrB"}, "0.0.0.0/32"]}]}]}, "AssertDescription": "New origin subnets need two confirmed availability zones and non-overlapping CIDR blocks."}]},
    "LoadBalancerSecurityGroupSource": {"Assertions": [{"Assert": {"Fn::Or": [{"Fn::And": [{"Fn::Equals": [{"Ref": "CreateLoadBalancerSecurityGroup"}, "true"]}, {"Fn::Equals": [{"Ref": "ExistingLoadBalancerSecurityGroupId"}, ""]}]}, {"Fn::And": [{"Fn::Equals": [{"Ref": "CreateLoadBalancerSecurityGroup"}, "false"]}, {"Fn::Not": [{"Fn::Equals": [{"Ref": "ExistingLoadBalancerSecurityGroupId"}, ""]}]}]}]}, "AssertDescription": "Select exactly one ALB security-group source: create it, or provide the existing ID."}]},
    "ApiSecurityGroupSource": {"Assertions": [{"Assert": {"Fn::Or": [{"Fn::And": [{"Fn::Equals": [{"Ref": "CreateApiSecurityGroup"}, "true"]}, {"Fn::Equals": [{"Ref": "ExistingApiSecurityGroupId"}, ""]}]}, {"Fn::And": [{"Fn::Equals": [{"Ref": "CreateApiSecurityGroup"}, "false"]}, {"Fn::Not": [{"Fn::Equals": [{"Ref": "ExistingApiSecurityGroupId"}, ""]}]}]}]}, "AssertDescription": "Select exactly one API security-group source: create it, or provide the existing ID."}]},
    "InternalAlbSource": {"Assertions": [{"Assert": {"Fn::Or": [{"Fn::And": [{"Fn::Equals": [{"Ref": "CreateInternalApiLoadBalancer"}, "true"]}, {"Fn::Equals": [{"Ref": "ExistingInternalApiLoadBalancerArn"}, ""]}, {"Fn::Equals": [{"Ref": "ExistingInternalApiLoadBalancerDnsName"}, ""]}]}, {"Fn::And": [{"Fn::Equals": [{"Ref": "CreateInternalApiLoadBalancer"}, "false"]}, {"Fn::Not": [{"Fn::Equals": [{"Ref": "ExistingInternalApiLoadBalancerArn"}, ""]}]}, {"Fn::Not": [{"Fn::Equals": [{"Ref": "ExistingInternalApiLoadBalancerDnsName"}, ""]}]}]}]}, "AssertDescription": "Select exactly one internal-ALB source: create it, or provide its existing ARN and private DNS name."}]},
    "TargetGroupSource": {"Assertions": [{"Assert": {"Fn::Or": [{"Fn::And": [{"Fn::Equals": [{"Ref": "CreateApiTargetGroup"}, "true"]}, {"Fn::Equals": [{"Ref": "ExistingApiTargetGroupArn"}, ""]}]}, {"Fn::And": [{"Fn::Equals": [{"Ref": "CreateApiTargetGroup"}, "false"]}, {"Fn::Not": [{"Fn::Equals": [{"Ref": "ExistingApiTargetGroupArn"}, ""]}]}]}]}, "AssertDescription": "Select exactly one API target-group source: create it, or provide the existing ARN."}]},
    "ListenerSource": {"Assertions": [{"Assert": {"Fn::Not": [{"Fn::And": [{"Fn::Equals": [{"Ref": "CreateInternalApiHttpListener"}, "true"]}, {"Fn::Not": [{"Fn::Equals": [{"Ref": "ExistingInternalApiHttpListenerArn"}, ""]}]}]}]}, "AssertDescription": "Do not create an HTTP listener when an existing listener ARN was selected."}]},
    "ServiceNeedsTaskDefinition": {"RuleCondition": {"Fn::Equals": [{"Ref": "CreateApiService"}, "true"]}, "Assertions": [{"Assert": {"Fn::Not": [{"Fn::Equals": [{"Ref": "ApiTaskDefinitionArn"}, ""]}]}, "AssertDescription": "An immutable registered task definition ARN is required for a new ECS service."}]},
    "PublicTaskEgressNeedsHttps": {"RuleCondition": {"Fn::Equals": [{"Ref": "ApiPublicIpEgress"}, "true"]}, "Assertions": [{"Assert": {"Fn::Equals": [{"Ref": "ApiHttpsEgressReady"}, "true"]}, "AssertDescription": "Explicit public-IP egress requires confirmed HTTPS-only egress; add it with EnableApiExternalHttpsEgress only when the selected security group lacks that rule."}]},
    "AddedHttpsEgressMustBeConfirmed": {"RuleCondition": {"Fn::Equals": [{"Ref": "EnableApiExternalHttpsEgress"}, "true"]}, "Assertions": [{"Assert": {"Fn::Equals": [{"Ref": "ApiHttpsEgressReady"}, "true"]}, "AssertDescription": "Adding an HTTPS egress rule requires explicit confirmation that Cognito JWKS and Bedrock need it."}]},
    "NewApiSecurityGroupNeedsRdsIngress": {"RuleCondition": {"Fn::Equals": [{"Ref": "CreateApiSecurityGroup"}, "true"]}, "Assertions": [{"Assert": {"Fn::Equals": [{"Ref": "AddRdsIngressFromApi"}, "true"]}, "AssertDescription": "A newly-created API security group must be explicitly authorized by the existing RDS security group."}]},
    "VpcOriginSource": {"Assertions": [{"Assert": {"Fn::Or": [{"Fn::And": [{"Fn::Equals": [{"Ref": "CreateCloudFrontVpcOrigin"}, "true"]}, {"Fn::Equals": [{"Ref": "ExistingCloudFrontVpcOriginId"}, ""]}]}, {"Fn::And": [{"Fn::Equals": [{"Ref": "CreateCloudFrontVpcOrigin"}, "false"]}, {"Fn::Not": [{"Fn::Equals": [{"Ref": "ExistingCloudFrontVpcOriginId"}, ""]}]}]}]}, "AssertDescription": "Select exactly one VPC-origin source: create it, or provide the existing VPC origin ID."}]},
    "CloudFrontPrefixListRequired": {"Assertions": [{"Assert": {"Fn::Not": [{"Fn::Equals": [{"Ref": "CloudFrontOriginPrefixListId"}, ""]}]}, "AssertDescription": "The AWS-managed CloudFront origin-facing prefix-list ID is required for internal-ALB ingress."}]}
  },
  "Conditions": {
    "CreateOriginPrivateSubnetsCondition": {"Fn::Equals": [{"Ref": "CreateOriginPrivateSubnets"}, "true"]},
    "CreateLoadBalancerSecurityGroupCondition": {"Fn::Equals": [{"Ref": "CreateLoadBalancerSecurityGroup"}, "true"]},
    "CreateApiSecurityGroupCondition": {"Fn::Equals": [{"Ref": "CreateApiSecurityGroup"}, "true"]},
    "EnsureApiIngressFromLoadBalancerCondition": {"Fn::Or": [{"Fn::Equals": [{"Ref": "CreateApiSecurityGroup"}, "true"]}, {"Fn::Equals": [{"Ref": "AddApiIngressFromLoadBalancer"}, "true"]}]},
    "AddRdsIngressFromApiCondition": {"Fn::Equals": [{"Ref": "AddRdsIngressFromApi"}, "true"]},
    "ApiExternalHttpsCondition": {"Fn::Equals": [{"Ref": "EnableApiExternalHttpsEgress"}, "true"]},
    "CreateInternalApiLoadBalancerCondition": {"Fn::Equals": [{"Ref": "CreateInternalApiLoadBalancer"}, "true"]},
    "CreateApiTargetGroupCondition": {"Fn::Equals": [{"Ref": "CreateApiTargetGroup"}, "true"]},
    "CreateInternalApiHttpListenerCondition": {"Fn::Equals": [{"Ref": "CreateInternalApiHttpListener"}, "true"]},
    "CreateApiServiceCondition": {"Fn::Equals": [{"Ref": "CreateApiService"}, "true"]},
    "ApiPublicIpEgressCondition": {"Fn::Equals": [{"Ref": "ApiPublicIpEgress"}, "true"]},
    "CreateCloudFrontVpcOriginCondition": {"Fn::Equals": [{"Ref": "CreateCloudFrontVpcOrigin"}, "true"]}
  },
  "Resources": {
    "OriginPrivateRouteTable": {"Condition": "CreateOriginPrivateSubnetsCondition", "Type": "AWS::EC2::RouteTable", "Properties": {"VpcId": {"Ref": "VpcId"}, "Tags": [{"Key": "Name", "Value": "novamind-crp-api-origin-private-dev"}, {"Key": "Project", "Value": "novamind-crp"}, {"Key": "Environment", "Value": "dev"}, {"Key": "ManagedBy", "Value": "CloudFormation"}]}},
    "OriginPrivateSubnetA": {"Condition": "CreateOriginPrivateSubnetsCondition", "Type": "AWS::EC2::Subnet", "Properties": {"VpcId": {"Ref": "VpcId"}, "AvailabilityZone": {"Ref": "OriginPrivateSubnetAzA"}, "CidrBlock": {"Ref": "OriginPrivateSubnetCidrA"}, "MapPublicIpOnLaunch": false, "Tags": [{"Key": "Name", "Value": "novamind-crp-api-origin-private-a-dev"}, {"Key": "Project", "Value": "novamind-crp"}, {"Key": "Environment", "Value": "dev"}, {"Key": "ManagedBy", "Value": "CloudFormation"}]}},
    "OriginPrivateSubnetB": {"Condition": "CreateOriginPrivateSubnetsCondition", "Type": "AWS::EC2::Subnet", "Properties": {"VpcId": {"Ref": "VpcId"}, "AvailabilityZone": {"Ref": "OriginPrivateSubnetAzB"}, "CidrBlock": {"Ref": "OriginPrivateSubnetCidrB"}, "MapPublicIpOnLaunch": false, "Tags": [{"Key": "Name", "Value": "novamind-crp-api-origin-private-b-dev"}, {"Key": "Project", "Value": "novamind-crp"}, {"Key": "Environment", "Value": "dev"}, {"Key": "ManagedBy", "Value": "CloudFormation"}]}},
    "OriginPrivateSubnetARouteAssociation": {"Condition": "CreateOriginPrivateSubnetsCondition", "Type": "AWS::EC2::SubnetRouteTableAssociation", "Properties": {"RouteTableId": {"Ref": "OriginPrivateRouteTable"}, "SubnetId": {"Ref": "OriginPrivateSubnetA"}}},
    "OriginPrivateSubnetBRouteAssociation": {"Condition": "CreateOriginPrivateSubnetsCondition", "Type": "AWS::EC2::SubnetRouteTableAssociation", "Properties": {"RouteTableId": {"Ref": "OriginPrivateRouteTable"}, "SubnetId": {"Ref": "OriginPrivateSubnetB"}}},
    "LoadBalancerSecurityGroup": {"Condition": "CreateLoadBalancerSecurityGroupCondition", "Type": "AWS::EC2::SecurityGroup", "Properties": {"GroupDescription": "NovaMind internal ALB ingress from CloudFront VPC Origin only", "VpcId": {"Ref": "VpcId"}, "SecurityGroupEgress": [{"IpProtocol": "tcp", "FromPort": 8000, "ToPort": 8000, "DestinationSecurityGroupId": {"Fn::If": ["CreateApiSecurityGroupCondition", {"Ref": "ApiSecurityGroup"}, {"Ref": "ExistingApiSecurityGroupId"}]}, "Description": "Internal ALB to API only"}], "Tags": [{"Key": "Project", "Value": "novamind-crp"}, {"Key": "Environment", "Value": "dev"}, {"Key": "ManagedBy", "Value": "CloudFormation"}]}},
    "InternalAlbIngressFromCloudFront": {"Condition": "CreateLoadBalancerSecurityGroupCondition", "Type": "AWS::EC2::SecurityGroupIngress", "Properties": {"GroupId": {"Ref": "LoadBalancerSecurityGroup"}, "IpProtocol": "tcp", "FromPort": 80, "ToPort": 80, "SourcePrefixListId": {"Ref": "CloudFrontOriginPrefixListId"}, "Description": "CloudFront VPC Origin to private HTTP listener"}},
    "ApiSecurityGroup": {"Condition": "CreateApiSecurityGroupCondition", "Type": "AWS::EC2::SecurityGroup", "Properties": {"GroupDescription": "NovaMind ECS API ingress from internal ALB only", "VpcId": {"Ref": "VpcId"}, "SecurityGroupEgress": [{"IpProtocol": "tcp", "FromPort": 5432, "ToPort": 5432, "DestinationSecurityGroupId": {"Ref": "RdsSecurityGroupId"}, "Description": "PostgreSQL only"}, {"IpProtocol": "udp", "FromPort": 53, "ToPort": 53, "CidrIp": {"Ref": "VpcCidr"}, "Description": "VPC DNS"}, {"IpProtocol": "tcp", "FromPort": 53, "ToPort": 53, "CidrIp": {"Ref": "VpcCidr"}, "Description": "VPC DNS"}]}},
    "ApiIngressFromLoadBalancer": {"Condition": "EnsureApiIngressFromLoadBalancerCondition", "Type": "AWS::EC2::SecurityGroupIngress", "Properties": {"GroupId": {"Fn::If": ["CreateApiSecurityGroupCondition", {"Ref": "ApiSecurityGroup"}, {"Ref": "ExistingApiSecurityGroupId"}]}, "IpProtocol": "tcp", "FromPort": 8000, "ToPort": 8000, "SourceSecurityGroupId": {"Fn::If": ["CreateLoadBalancerSecurityGroupCondition", {"Ref": "LoadBalancerSecurityGroup"}, {"Ref": "ExistingLoadBalancerSecurityGroupId"}]}, "Description": "Internal ALB to ECS API"}},
    "RdsIngressFromApi": {"Condition": "AddRdsIngressFromApiCondition", "Type": "AWS::EC2::SecurityGroupIngress", "Properties": {"GroupId": {"Ref": "RdsSecurityGroupId"}, "IpProtocol": "tcp", "FromPort": 5432, "ToPort": 5432, "SourceSecurityGroupId": {"Fn::If": ["CreateApiSecurityGroupCondition", {"Ref": "ApiSecurityGroup"}, {"Ref": "ExistingApiSecurityGroupId"}]}, "Description": "ECS API to private PostgreSQL"}},
    "ApiExternalHttpsEgress": {"Condition": "ApiExternalHttpsCondition", "Type": "AWS::EC2::SecurityGroupEgress", "Properties": {"GroupId": {"Fn::If": ["CreateApiSecurityGroupCondition", {"Ref": "ApiSecurityGroup"}, {"Ref": "ExistingApiSecurityGroupId"}]}, "IpProtocol": "tcp", "FromPort": 443, "ToPort": 443, "CidrIp": "0.0.0.0/0", "Description": "Explicit HTTPS egress for Cognito JWKS and Bedrock"}},
    "InternalApiLoadBalancer": {"Condition": "CreateInternalApiLoadBalancerCondition", "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer", "Properties": {"Name": "novamind-crp-api-internal", "Scheme": "internal", "Type": "application", "IpAddressType": "ipv4", "SecurityGroups": [{"Fn::If": ["CreateLoadBalancerSecurityGroupCondition", {"Ref": "LoadBalancerSecurityGroup"}, {"Ref": "ExistingLoadBalancerSecurityGroupId"}]}], "Subnets": {"Fn::If": ["CreateOriginPrivateSubnetsCondition", [{"Ref": "OriginPrivateSubnetA"}, {"Ref": "OriginPrivateSubnetB"}], [{"Ref": "ExistingOriginPrivateSubnetAId"}, {"Ref": "ExistingOriginPrivateSubnetBId"}]]}, "LoadBalancerAttributes": [{"Key": "routing.http.drop_invalid_header_fields.enabled", "Value": "true"}], "Tags": [{"Key": "Project", "Value": "novamind-crp"}, {"Key": "Environment", "Value": "dev"}, {"Key": "ManagedBy", "Value": "CloudFormation"}]}},
    "ApiTargetGroup": {"Condition": "CreateApiTargetGroupCondition", "Type": "AWS::ElasticLoadBalancingV2::TargetGroup", "Properties": {"Name": "novamind-crp-api", "VpcId": {"Ref": "VpcId"}, "TargetType": "ip", "Protocol": "HTTP", "Port": 8000, "HealthCheckProtocol": "HTTP", "HealthCheckPath": "/api/health", "Matcher": {"HttpCode": "200"}, "HealthCheckIntervalSeconds": 30, "HealthCheckTimeoutSeconds": 5, "HealthyThresholdCount": 2, "UnhealthyThresholdCount": 2, "TargetGroupAttributes": [{"Key": "deregistration_delay.timeout_seconds", "Value": "30"}], "Tags": [{"Key": "Project", "Value": "novamind-crp"}, {"Key": "Environment", "Value": "dev"}, {"Key": "ManagedBy", "Value": "CloudFormation"}]}},
    "InternalApiHttpListener": {"Condition": "CreateInternalApiHttpListenerCondition", "Type": "AWS::ElasticLoadBalancingV2::Listener", "Properties": {"LoadBalancerArn": {"Fn::If": ["CreateInternalApiLoadBalancerCondition", {"Ref": "InternalApiLoadBalancer"}, {"Ref": "ExistingInternalApiLoadBalancerArn"}]}, "Port": 80, "Protocol": "HTTP", "DefaultActions": [{"Type": "forward", "TargetGroupArn": {"Fn::If": ["CreateApiTargetGroupCondition", {"Ref": "ApiTargetGroup"}, {"Ref": "ExistingApiTargetGroupArn"}]}}]}},
    "ApiService": {"Condition": "CreateApiServiceCondition", "Type": "AWS::ECS::Service", "Properties": {"ServiceName": {"Ref": "ApiServiceName"}, "Cluster": {"Ref": "ClusterName"}, "LaunchType": "FARGATE", "DesiredCount": {"Ref": "DesiredCount"}, "TaskDefinition": {"Ref": "ApiTaskDefinitionArn"}, "EnableExecuteCommand": false, "HealthCheckGracePeriodSeconds": 60, "DeploymentConfiguration": {"DeploymentCircuitBreaker": {"Enable": true, "Rollback": true}, "MaximumPercent": 200, "MinimumHealthyPercent": 100}, "NetworkConfiguration": {"AwsvpcConfiguration": {"AssignPublicIp": {"Fn::If": ["ApiPublicIpEgressCondition", "ENABLED", "DISABLED"]}, "Subnets": {"Ref": "ApplicationPublicSubnetIds"}, "SecurityGroups": [{"Fn::If": ["CreateApiSecurityGroupCondition", {"Ref": "ApiSecurityGroup"}, {"Ref": "ExistingApiSecurityGroupId"}]}]}}, "LoadBalancers": [{"ContainerName": {"Ref": "ApiContainerName"}, "ContainerPort": 8000, "TargetGroupArn": {"Fn::If": ["CreateApiTargetGroupCondition", {"Ref": "ApiTargetGroup"}, {"Ref": "ExistingApiTargetGroupArn"}]}}]}},
    "CloudFrontVpcOrigin": {"Condition": "CreateCloudFrontVpcOriginCondition", "Type": "AWS::CloudFront::VpcOrigin", "Properties": {"Tags": [{"Key": "Project", "Value": "novamind-crp"}, {"Key": "Environment", "Value": "dev"}, {"Key": "ManagedBy", "Value": "CloudFormation"}], "VpcOriginEndpointConfig": {"Name": {"Ref": "VpcOriginName"}, "Arn": {"Fn::If": ["CreateInternalApiLoadBalancerCondition", {"Ref": "InternalApiLoadBalancer"}, {"Ref": "ExistingInternalApiLoadBalancerArn"}]}, "HTTPPort": 80, "OriginProtocolPolicy": "http-only", "IpAddressType": "ipv4"}}}
  },
  "Outputs": {
    "OriginPrivateSubnetAId": {"Value": {"Fn::If": ["CreateOriginPrivateSubnetsCondition", {"Ref": "OriginPrivateSubnetA"}, {"Ref": "ExistingOriginPrivateSubnetAId"}]}},
    "OriginPrivateSubnetBId": {"Value": {"Fn::If": ["CreateOriginPrivateSubnetsCondition", {"Ref": "OriginPrivateSubnetB"}, {"Ref": "ExistingOriginPrivateSubnetBId"}]}},
    "LoadBalancerSecurityGroupId": {"Value": {"Fn::If": ["CreateLoadBalancerSecurityGroupCondition", {"Ref": "LoadBalancerSecurityGroup"}, {"Ref": "ExistingLoadBalancerSecurityGroupId"}]}},
    "ApiSecurityGroupId": {"Value": {"Fn::If": ["CreateApiSecurityGroupCondition", {"Ref": "ApiSecurityGroup"}, {"Ref": "ExistingApiSecurityGroupId"}]}},
    "InternalApiLoadBalancerArn": {"Value": {"Fn::If": ["CreateInternalApiLoadBalancerCondition", {"Ref": "InternalApiLoadBalancer"}, {"Ref": "ExistingInternalApiLoadBalancerArn"}]}},
    "InternalApiLoadBalancerDnsName": {"Value": {"Fn::If": ["CreateInternalApiLoadBalancerCondition", {"Fn::GetAtt": ["InternalApiLoadBalancer", "DNSName"]}, {"Ref": "ExistingInternalApiLoadBalancerDnsName"}]}},
    "ApiTargetGroupArn": {"Value": {"Fn::If": ["CreateApiTargetGroupCondition", {"Ref": "ApiTargetGroup"}, {"Ref": "ExistingApiTargetGroupArn"}]}},
    "CloudFrontVpcOriginId": {"Value": {"Fn::If": ["CreateCloudFrontVpcOriginCondition", {"Ref": "CloudFrontVpcOrigin"}, {"Ref": "ExistingCloudFrontVpcOriginId"}]}}
  }
}
