{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyBootstrapSecrets",
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue"],
      "Resource": ["__RDS_MASTER_SECRET_ARN__", "__APPLICATION_SECRET_ARN__"]
    },
    {
      "Sid": "WriteOnlyApplicationConnectionSecret",
      "Effect": "Allow",
      "Action": ["secretsmanager:PutSecretValue"],
      "Resource": "__APPLICATION_SECRET_ARN__"
    }
  ]
}
