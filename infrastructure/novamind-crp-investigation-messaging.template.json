{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Opt-in novamind-crp dev investigation messaging foundation: encrypted SQS/DLQ, separate ECS task roles, workload networking, and retained CloudWatch log groups. It does not create ECS services, task definitions, RDS, secrets, or legacy resources.",
  "Parameters": {
    "ProjectPrefix": {"Type": "String", "Default": "novamind-crp", "AllowedValues": ["novamind-crp"]},
    "Environment": {"Type": "String", "Default": "dev", "AllowedValues": ["dev"]},
    "VpcId": {"Type": "AWS::EC2::VPC::Id"},
    "VpcCidr": {"Type": "String", "AllowedPattern": "^[0-9.]+/[0-9]{1,2}$"},
    "RdsSecurityGroupId": {"Type": "AWS::EC2::SecurityGroup::Id"},
    "CreateWorkloadSecurityGroup": {"Type": "String", "Default": "false", "AllowedValues": ["true", "false"]},
    "ExistingWorkloadSecurityGroupId": {"Type": "String", "Default": "", "AllowedPattern": "^$|^sg-[0-9a-f]+$"},
    "QueueVisibilityTimeoutSeconds": {"Type": "Number", "Default": 300, "MinValue": 90, "MaxValue": 43200, "Description": "Must exceed the bounded 30-second model timeout plus 60-second shutdown margin; default is 300 seconds."},
    "QueueRetentionSeconds": {"Type": "Number", "Default": 1209600, "AllowedValues": [60, 300, 900, 1800, 3600, 10800, 21600, 43200, 86400, 172800, 345600, 691200, 1209600]},
    "MaximumReceiveCount": {"Type": "Number", "Default": 5, "MinValue": 1, "MaxValue": 1000},
    "LogRetentionDays": {"Type": "Number", "Default": 30, "AllowedValues": [1, 3, 5, 7, 14, 30, 60, 90, 120, 150, 180, 365, 400, 545, 731, 1827, 3653]}
  },
  "Rules": {
    "WorkloadSecurityGroupSource": {
      "Assertions": [{
        "Assert": {"Fn::Or": [
          {"Fn::And": [
            {"Fn::Equals": [{"Ref": "CreateWorkloadSecurityGroup"}, "true"]},
            {"Fn::Equals": [{"Ref": "ExistingWorkloadSecurityGroupId"}, ""]}
          ]},
          {"Fn::And": [
            {"Fn::Equals": [{"Ref": "CreateWorkloadSecurityGroup"}, "false"]},
            {"Fn::Not": [{"Fn::Equals": [{"Ref": "ExistingWorkloadSecurityGroupId"}, ""]}]}
          ]}
        ]},
        "AssertDescription": "Select exactly one workload security-group source."
      }]
    }
  },
  "Conditions": {
    "CreateWorkloadSecurityGroupCondition": {"Fn::Equals": [{"Ref": "CreateWorkloadSecurityGroup"}, "true"]}
  },
  "Resources": {
    "InvestigationDeadLetterQueue": {
      "Type": "AWS::SQS::Queue",
      "UpdateReplacePolicy": "Retain",
      "DeletionPolicy": "Retain",
      "Properties": {
        "QueueName": {"Fn::Sub": "${ProjectPrefix}-investigation-dlq-${Environment}"},
        "SqsManagedSseEnabled": true,
        "VisibilityTimeout": {"Ref": "QueueVisibilityTimeoutSeconds"},
        "MessageRetentionPeriod": {"Ref": "QueueRetentionSeconds"},
        "Tags": [
          {"Key": "Project", "Value": "novamind-crp"},
          {"Key": "Environment", "Value": "dev"},
          {"Key": "ManagedBy", "Value": "CloudFormation"}
        ]
      }
    },
    "InvestigationQueue": {
      "Type": "AWS::SQS::Queue",
      "UpdateReplacePolicy": "Retain",
      "DeletionPolicy": "Retain",
      "Properties": {
        "QueueName": {"Fn::Sub": "${ProjectPrefix}-investigation-${Environment}"},
        "SqsManagedSseEnabled": true,
        "VisibilityTimeout": {"Ref": "QueueVisibilityTimeoutSeconds"},
        "MessageRetentionPeriod": {"Ref": "QueueRetentionSeconds"},
        "ReceiveMessageWaitTimeSeconds": 20,
        "RedrivePolicy": {
          "deadLetterTargetArn": {"Fn::GetAtt": ["InvestigationDeadLetterQueue", "Arn"]},
          "maxReceiveCount": {"Ref": "MaximumReceiveCount"}
        },
        "Tags": [
          {"Key": "Project", "Value": "novamind-crp"},
          {"Key": "Environment", "Value": "dev"},
          {"Key": "ManagedBy", "Value": "CloudFormation"}
        ]
      }
    },
    "WorkloadSecurityGroup": {
      "Condition": "CreateWorkloadSecurityGroupCondition",
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupName": {"Fn::Sub": "${ProjectPrefix}-investigation-workload-${Environment}"},
        "GroupDescription": "NovaMind publisher and Strands worker: no ingress; PostgreSQL and HTTPS egress only.",
        "VpcId": {"Ref": "VpcId"},
        "SecurityGroupEgress": [
          {"IpProtocol": "tcp", "FromPort": 5432, "ToPort": 5432, "DestinationSecurityGroupId": {"Ref": "RdsSecurityGroupId"}, "Description": "PostgreSQL only"},
          {"IpProtocol": "udp", "FromPort": 53, "ToPort": 53, "CidrIp": {"Ref": "VpcCidr"}, "Description": "VPC DNS"},
          {"IpProtocol": "tcp", "FromPort": 53, "ToPort": 53, "CidrIp": {"Ref": "VpcCidr"}, "Description": "VPC DNS"},
          {"IpProtocol": "tcp", "FromPort": 443, "ToPort": 443, "CidrIp": "0.0.0.0/0", "Description": "SQS, Bedrock, and Secrets Manager HTTPS egress"}
        ],
        "Tags": [
          {"Key": "Project", "Value": "novamind-crp"},
          {"Key": "Environment", "Value": "dev"},
          {"Key": "ManagedBy", "Value": "CloudFormation"}
        ]
      }
    },
    "ApiTaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {"Fn::Sub": "${ProjectPrefix}-api-task-role-${Environment}"},
        "AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "ecs-tasks.amazonaws.com"}, "Action": "sts:AssumeRole"}]},
        "Policies": [],
        "Tags": [{"Key": "Project", "Value": "novamind-crp"}, {"Key": "Environment", "Value": "dev"}, {"Key": "ManagedBy", "Value": "CloudFormation"}]
      }
    },
    "PublisherTaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {"Fn::Sub": "${ProjectPrefix}-publisher-task-role-${Environment}"},
        "AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "ecs-tasks.amazonaws.com"}, "Action": "sts:AssumeRole"}]},
        "Policies": [{"PolicyName": {"Fn::Sub": "${ProjectPrefix}-publisher-queue-${Environment}"}, "PolicyDocument": {"Version": "2012-10-17", "Statement": [{"Sid": "PublishInvestigationReferencesOnly", "Effect": "Allow", "Action": ["sqs:SendMessage", "sqs:GetQueueAttributes"], "Resource": {"Fn::GetAtt": ["InvestigationQueue", "Arn"]}}]}}],
        "Tags": [{"Key": "Project", "Value": "novamind-crp"}, {"Key": "Environment", "Value": "dev"}, {"Key": "ManagedBy", "Value": "CloudFormation"}]
      }
    },
    "StrandsWorkerTaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {"Fn::Sub": "${ProjectPrefix}-strands-worker-task-role-${Environment}"},
        "AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "ecs-tasks.amazonaws.com"}, "Action": "sts:AssumeRole"}]},
        "Policies": [{"PolicyName": {"Fn::Sub": "${ProjectPrefix}-worker-queue-bedrock-${Environment}"}, "PolicyDocument": {"Version": "2012-10-17", "Statement": [{"Sid": "ConsumeInvestigationReferencesOnly", "Effect": "Allow", "Action": ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:ChangeMessageVisibility", "sqs:GetQueueAttributes"], "Resource": {"Fn::GetAtt": ["InvestigationQueue", "Arn"]}}, {"Sid": "InvokeNovaMindCrpNovaLiteInferenceProfile", "Effect": "Allow", "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"], "Resource": [{"Fn::Sub": "arn:${AWS::Partition}:bedrock:us-east-1:${AWS::AccountId}:inference-profile/us.amazon.nova-lite-v1:0"}]}, {"Sid": "InvokeNovaMindCrpNovaLiteFoundationModels", "Effect": "Allow", "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"], "Resource": [{"Fn::Sub": "arn:${AWS::Partition}:bedrock:us-east-1::foundation-model/amazon.nova-lite-v1:0"}, {"Fn::Sub": "arn:${AWS::Partition}:bedrock:us-east-2::foundation-model/amazon.nova-lite-v1:0"}, {"Fn::Sub": "arn:${AWS::Partition}:bedrock:us-west-2::foundation-model/amazon.nova-lite-v1:0"}], "Condition": {"StringEquals": {"bedrock:InferenceProfileArn": {"Fn::Sub": "arn:${AWS::Partition}:bedrock:us-east-1:${AWS::AccountId}:inference-profile/us.amazon.nova-lite-v1:0"}}}}]}}],
        "Tags": [{"Key": "Project", "Value": "novamind-crp"}, {"Key": "Environment", "Value": "dev"}, {"Key": "ManagedBy", "Value": "CloudFormation"}]
      }
    },
    "ApiLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {"LogGroupName": {"Fn::Sub": "/ecs/${ProjectPrefix}/api/${Environment}"}, "RetentionInDays": {"Ref": "LogRetentionDays"}, "Tags": [{"Key": "Project", "Value": "novamind-crp"}, {"Key": "Environment", "Value": "dev"}, {"Key": "ManagedBy", "Value": "CloudFormation"}]}
    },
    "PublisherLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {"LogGroupName": {"Fn::Sub": "/ecs/${ProjectPrefix}/publisher/${Environment}"}, "RetentionInDays": {"Ref": "LogRetentionDays"}, "Tags": [{"Key": "Project", "Value": "novamind-crp"}, {"Key": "Environment", "Value": "dev"}, {"Key": "ManagedBy", "Value": "CloudFormation"}]}
    },
    "StrandsWorkerLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {"LogGroupName": {"Fn::Sub": "/ecs/${ProjectPrefix}/strands-worker/${Environment}"}, "RetentionInDays": {"Ref": "LogRetentionDays"}, "Tags": [{"Key": "Project", "Value": "novamind-crp"}, {"Key": "Environment", "Value": "dev"}, {"Key": "ManagedBy", "Value": "CloudFormation"}]}
    }
  },
  "Outputs": {
    "InvestigationQueueUrl": {"Value": {"Ref": "InvestigationQueue"}, "Export": {"Name": {"Fn::Sub": "${ProjectPrefix}-${Environment}-InvestigationQueueUrl"}}},
    "InvestigationDeadLetterQueueArn": {"Value": {"Fn::GetAtt": ["InvestigationDeadLetterQueue", "Arn"]}, "Export": {"Name": {"Fn::Sub": "${ProjectPrefix}-${Environment}-InvestigationDeadLetterQueueArn"}}},
    "InvestigationDeadLetterQueueUrl": {"Value": {"Ref": "InvestigationDeadLetterQueue"}, "Export": {"Name": {"Fn::Sub": "${ProjectPrefix}-${Environment}-InvestigationDeadLetterQueueUrl"}}},
    "ApiTaskRoleArn": {"Value": {"Fn::GetAtt": ["ApiTaskRole", "Arn"]}, "Export": {"Name": {"Fn::Sub": "${ProjectPrefix}-${Environment}-ApiTaskRoleArn"}}},
    "PublisherTaskRoleArn": {"Value": {"Fn::GetAtt": ["PublisherTaskRole", "Arn"]}, "Export": {"Name": {"Fn::Sub": "${ProjectPrefix}-${Environment}-PublisherTaskRoleArn"}}},
    "StrandsWorkerTaskRoleArn": {"Value": {"Fn::GetAtt": ["StrandsWorkerTaskRole", "Arn"]}, "Export": {"Name": {"Fn::Sub": "${ProjectPrefix}-${Environment}-StrandsWorkerTaskRoleArn"}}},
    "WorkloadSecurityGroupId": {"Value": {"Fn::If": ["CreateWorkloadSecurityGroupCondition", {"Ref": "WorkloadSecurityGroup"}, {"Ref": "ExistingWorkloadSecurityGroupId"}]}, "Export": {"Name": {"Fn::Sub": "${ProjectPrefix}-${Environment}-WorkloadSecurityGroupId"}}},
    "QueueVisibilityTimeoutSeconds": {"Value": {"Ref": "QueueVisibilityTimeoutSeconds"}, "Export": {"Name": {"Fn::Sub": "${ProjectPrefix}-${Environment}-QueueVisibilityTimeoutSeconds"}}},
    "ApiLogGroupName": {"Value": {"Ref": "ApiLogGroup"}, "Export": {"Name": {"Fn::Sub": "${ProjectPrefix}-${Environment}-ApiLogGroupName"}}},
    "PublisherLogGroupName": {"Value": {"Ref": "PublisherLogGroup"}, "Export": {"Name": {"Fn::Sub": "${ProjectPrefix}-${Environment}-PublisherLogGroupName"}}},
    "StrandsWorkerLogGroupName": {"Value": {"Ref": "StrandsWorkerLogGroup"}, "Export": {"Name": {"Fn::Sub": "${ProjectPrefix}-${Environment}-StrandsWorkerLogGroupName"}}}
  }
}
