{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Opt-in one-shot sanitized Cognito configuration diagnostic for novamind-crp dev.",
  "Parameters": {
    "ProjectPrefix": {
      "Type": "String",
      "Default": "novamind-crp",
      "AllowedValues": [
        "novamind-crp"
      ]
    },
    "Environment": {
      "Type": "String",
      "Default": "dev",
      "AllowedValues": [
        "dev"
      ]
    },
    "ImageUri": {
      "Type": "String",
      "Default": "357001292388.dkr.ecr.us-east-1.amazonaws.com/novamind-crp-backend-dev@sha256:f740cccc19d02688af249e896785be2c3e2c00ad8be2369d60391e3e82d06d3a",
      "AllowedPattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[A-Za-z0-9._/-]+@sha256:[a-f0-9]{64}$"
    },
    "CognitoConfigurationSecretArn": {
      "Type": "String",
      "Description": "Project Cognito configuration secret; only five JSON keys are projected.",
      "AllowedPattern": "^arn:aws(?:-[a-z-]+)?:secretsmanager:[a-z0-9-]+:[0-9]{12}:secret:novamind-crp-[A-Za-z0-9/_+=.@!-]+$"
    },
    "ExecutionRoleName": {
      "Type": "String",
      "Default": "novamind-crp-cognito-config-diagnostic-execution-dev",
      "AllowedPattern": "^novamind-crp-cognito-config-diagnostic-execution-dev$"
    },
    "LogRetentionDays": {
      "Type": "Number",
      "Default": 1,
      "AllowedValues": [
        1,
        3,
        5,
        7
      ]
    }
  },
  "Resources": {
    "DiagnosticLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/ecs/${ProjectPrefix}/cognito-config-diagnostic/${Environment}"
        },
        "RetentionInDays": {
          "Ref": "LogRetentionDays"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "novamind-crp"
          },
          {
            "Key": "Environment",
            "Value": "dev"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "DiagnosticExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Ref": "ExecutionRoleName"
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": {
              "Fn::Sub": "${ProjectPrefix}-cognito-config-diagnostic-execution-${Environment}"
            },
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "PullImageToken",
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Sid": "PullImage",
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecr:${AWS::Region}:${AWS::AccountId}:repository/novamind-crp-backend-dev"
                  }
                },
                {
                  "Sid": "WriteDiagnosticLogs",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "${DiagnosticLogGroup.Arn}:*"
                  }
                },
                {
                  "Sid": "ReadCognitoConfigurationOnly",
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": {
                    "Ref": "CognitoConfigurationSecretArn"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "novamind-crp"
          },
          {
            "Key": "Environment",
            "Value": "dev"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "DiagnosticTaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": {
          "Fn::Sub": "${ProjectPrefix}-cognito-config-diagnostic-${Environment}"
        },
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "Cpu": "512",
        "Memory": "1024",
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "DiagnosticExecutionRole",
            "Arn"
          ]
        },
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ContainerDefinitions": [
          {
            "Name": "diagnostic",
            "Image": {
              "Ref": "ImageUri"
            },
            "Essential": true,
            "ReadonlyRootFilesystem": true,
            "Command": [
              "python",
              "-c",
              "import base64;exec(compile(base64.b64decode(''),'cognito-diagnostic','exec'))"
            ],
            "Environment": [
              {
                "Name": "PYTHONUNBUFFERED",
                "Value": "1"
              }
            ],
            "Secrets": [
              {
                "Name": "NOVAMIND_COGNITO_ISSUER",
                "ValueFrom": {
                  "Fn::Sub": "${CognitoConfigurationSecretArn}:issuer::"
                }
              },
              {
                "Name": "NOVAMIND_COGNITO_CLIENT_ID",
                "ValueFrom": {
                  "Fn::Sub": "${CognitoConfigurationSecretArn}:client_id::"
                }
              },
              {
                "Name": "NOVAMIND_COGNITO_CUSTOMER_GROUP",
                "ValueFrom": {
                  "Fn::Sub": "${CognitoConfigurationSecretArn}:customer_group::"
                }
              },
              {
                "Name": "NOVAMIND_COGNITO_ADMIN_GROUP",
                "ValueFrom": {
                  "Fn::Sub": "${CognitoConfigurationSecretArn}:admin_group::"
                }
              },
              {
                "Name": "NOVAMIND_COGNITO_CUSTOMER_BINDINGS",
                "ValueFrom": {
                  "Fn::Sub": "${CognitoConfigurationSecretArn}:customer_bindings::"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "DiagnosticLogGroup"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "diagnostic"
              }
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "DiagnosticTaskDefinitionArn": {
      "Value": {
        "Ref": "DiagnosticTaskDefinition"
      }
    },
    "DiagnosticLogGroupName": {
      "Value": {
        "Ref": "DiagnosticLogGroup"
      }
    },
    "DiagnosticExecutionRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "DiagnosticExecutionRole",
          "Arn"
        ]
      }
    }
  }
}
