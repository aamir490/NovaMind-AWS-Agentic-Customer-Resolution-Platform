{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Opt-in NovaMind one-shot RDS bootstrap IAM, logging, and zero-ingress public-bootstrap security-group support. It never creates, reads, rotates, or exposes database secrets, NAT gateways, or permanent services.",
  "Parameters": {
    "CreateBootstrapTaskRole": {"Type": "String", "Default": "false", "AllowedValues": ["true", "false"]},
    "BootstrapTaskRoleName": {"Type": "String", "Default": "novamind-rds-bootstrap-task", "AllowedPattern": "^[A-Za-z0-9_+=,.@-]{1,64}$"},
    "ExistingBootstrapTaskRoleName": {"Type": "String", "Default": ""},
    "CreateBootstrapExecutionRole": {"Type": "String", "Default": "false", "AllowedValues": ["true", "false"]},
    "BootstrapExecutionRoleName": {"Type": "String", "Default": "novamind-crp-bootstrap-execution-dev", "AllowedPattern": "^[A-Za-z0-9_+=,.@-]{1,64}$"},
    "ExistingBootstrapExecutionRoleName": {"Type": "String", "Default": ""},
    "BootstrapEcrRepositoryArn": {"Type": "String", "AllowedPattern": "^arn:aws(?:-[a-z-]+)?:ecr:[a-z0-9-]+:[0-9]{12}:repository/[A-Za-z0-9._/-]+$"},
    "CreateBootstrapLogGroup": {"Type": "String", "Default": "false", "AllowedValues": ["true", "false"]},
    "BootstrapLogGroupName": {"Type": "String", "Default": "/ecs/novamind-rds-bootstrap", "AllowedPattern": "^[A-Za-z0-9_./#:-]{1,512}$"},
    "LogRetentionDays": {"Type": "Number", "Default": 7, "AllowedValues": [1, 3, 5, 7, 14, 30, 60, 90, 120, 150, 180, 365]},
    "CreateBootstrapSecurityGroup": {"Type": "String", "Default": "false", "AllowedValues": ["true", "false"]},
    "BootstrapSecurityGroupName": {"Type": "String", "Default": "novamind-crp-bootstrap-sg-dev", "AllowedPattern": "^[A-Za-z0-9_+=,.@-]{1,255}$"},
    "BootstrapPublicInternetEgressApproved": {"Type": "String", "Default": "false", "AllowedValues": ["true", "false"]},
    "VpcId": {"Type": "String", "Default": "", "AllowedPattern": "^$|^vpc-[0-9a-f]+$"},
    "RdsSecurityGroupId": {"Type": "String", "Default": "", "AllowedPattern": "^$|^sg-[0-9a-f]+$"},
    "RdsMasterSecretArn": {"Type": "String", "AllowedPattern": "^arn:aws(?:-[a-z-]+)?:secretsmanager:[a-z0-9-]+:[0-9]{12}:secret:[A-Za-z0-9/_+=.@!\\-]+$"},
    "ApplicationSecretArn": {"Type": "String", "AllowedPattern": "^arn:aws(?:-[a-z-]+)?:secretsmanager:[a-z0-9-]+:[0-9]{12}:secret:[A-Za-z0-9/_+=.@!\\-]+$"},
    "AttachApiApplicationSecretReadPolicy": {"Type": "String", "Default": "false", "AllowedValues": ["true", "false"]},
    "ApiExecutionRoleName": {"Type": "String", "Default": "", "AllowedPattern": "^$|^[A-Za-z0-9_+=,.@-]{1,64}$"},
    "AttachApiBedrockInvokePolicy": {"Type": "String", "Default": "false", "AllowedValues": ["true", "false"]},
    "ApiTaskRoleName": {"Type": "String", "Default": "", "AllowedPattern": "^$|^[A-Za-z0-9_+=,.@-]{1,64}$"},
    "ApprovedBedrockModelArn": {"Type": "String", "Default": "", "AllowedPattern": "^$|^arn:aws:bedrock:us-east-1:[0-9]{12}:inference-profile/us\\.amazon\\.nova-lite-v1:0$"},
    "AttachBootstrapMasterKmsDecrypt": {"Type": "String", "Default": "false", "AllowedValues": ["true", "false"]},
    "MasterSecretKmsKeyArn": {"Type": "String", "Default": ""},
    "AttachBootstrapApplicationKmsDecrypt": {"Type": "String", "Default": "false", "AllowedValues": ["true", "false"]},
    "ApplicationSecretKmsKeyArn": {"Type": "String", "Default": ""}
  },
  "Rules": {
    "BootstrapRoleSource": {"Assertions": [{"Assert": {"Fn::Or": [{"Fn::And": [{"Fn::Equals": [{"Ref": "CreateBootstrapTaskRole"}, "true"]}, {"Fn::Equals": [{"Ref": "ExistingBootstrapTaskRoleName"}, ""]}]}, {"Fn::And": [{"Fn::Equals": [{"Ref": "CreateBootstrapTaskRole"}, "false"]}, {"Fn::Not": [{"Fn::Equals": [{"Ref": "ExistingBootstrapTaskRoleName"}, ""]}]}]}]}, "AssertDescription": "Select exactly one bootstrap task-role source: create it, or provide the existing role name."}]},
    "BootstrapExecutionRoleSource": {"Assertions": [{"Assert": {"Fn::Or": [{"Fn::And": [{"Fn::Equals": [{"Ref": "CreateBootstrapExecutionRole"}, "true"]}, {"Fn::Equals": [{"Ref": "ExistingBootstrapExecutionRoleName"}, ""]}]}, {"Fn::And": [{"Fn::Equals": [{"Ref": "CreateBootstrapExecutionRole"}, "false"]}, {"Fn::Not": [{"Fn::Equals": [{"Ref": "ExistingBootstrapExecutionRoleName"}, ""]}]}]}]}, "AssertDescription": "Select exactly one bootstrap execution-role source: create the dedicated role, or provide an existing dedicated ECS execution role."}]},
    "BootstrapSecurityGroupDependencies": {"RuleCondition": {"Fn::Equals": [{"Ref": "CreateBootstrapSecurityGroup"}, "true"]}, "Assertions": [{"Assert": {"Fn::And": [{"Fn::Not": [{"Fn::Equals": [{"Ref": "VpcId"}, ""]}]}, {"Fn::Not": [{"Fn::Equals": [{"Ref": "RdsSecurityGroupId"}, ""]}]}, {"Fn::Equals": [{"Ref": "BootstrapPublicInternetEgressApproved"}, "true"]}]}, "AssertDescription": "Creating the public-subnet bootstrap security group requires the VPC, RDS security group, and explicit approval for port-443 internet egress. No other public egress is supported."}]},
    "ApiExecutionRoleForAttachment": {"RuleCondition": {"Fn::Equals": [{"Ref": "AttachApiApplicationSecretReadPolicy"}, "true"]}, "Assertions": [{"Assert": {"Fn::Not": [{"Fn::Equals": [{"Ref": "ApiExecutionRoleName"}, ""]}]}, "AssertDescription": "The existing API execution role name is required to attach the application-secret policy."}]},
    "ApiTaskRoleForBedrock": {"RuleCondition": {"Fn::Equals": [{"Ref": "AttachApiBedrockInvokePolicy"}, "true"]}, "Assertions": [{"Assert": {"Fn::And": [{"Fn::Not": [{"Fn::Equals": [{"Ref": "ApiTaskRoleName"}, ""]}]}, {"Fn::Not": [{"Fn::Equals": [{"Ref": "ApprovedBedrockModelArn"}, ""]}]}]}, "AssertDescription": "AttachApiBedrockInvokePolicy requires the existing API task role name and the exact Nova Lite cross-region inference-profile ARN for the account in us-east-1 (arn:aws:bedrock:us-east-1:<account>:inference-profile/us.amazon.nova-lite-v1:0)."}]},
    "MasterKmsKeyForAttachment": {"RuleCondition": {"Fn::Equals": [{"Ref": "AttachBootstrapMasterKmsDecrypt"}, "true"]}, "Assertions": [{"Assert": {"Fn::Not": [{"Fn::Equals": [{"Ref": "MasterSecretKmsKeyArn"}, ""]}]}, "AssertDescription": "The master-secret CMK ARN is required only when attaching its decrypt permission."}]},
    "ApplicationKmsKeyForAttachment": {"RuleCondition": {"Fn::Equals": [{"Ref": "AttachBootstrapApplicationKmsDecrypt"}, "true"]}, "Assertions": [{"Assert": {"Fn::Not": [{"Fn::Equals": [{"Ref": "ApplicationSecretKmsKeyArn"}, ""]}]}, "AssertDescription": "The application-secret CMK ARN is required only when attaching its decrypt permission."}]}
  },
  "Conditions": {
    "CreateBootstrapTaskRoleCondition": {"Fn::Equals": [{"Ref": "CreateBootstrapTaskRole"}, "true"]},
    "CreateBootstrapExecutionRoleCondition": {"Fn::Equals": [{"Ref": "CreateBootstrapExecutionRole"}, "true"]},
    "CreateBootstrapLogGroupCondition": {"Fn::Equals": [{"Ref": "CreateBootstrapLogGroup"}, "true"]},
    "CreateBootstrapSecurityGroupCondition": {"Fn::Equals": [{"Ref": "CreateBootstrapSecurityGroup"}, "true"]},
    "AttachApiApplicationSecretReadPolicyCondition": {"Fn::Equals": [{"Ref": "AttachApiApplicationSecretReadPolicy"}, "true"]},
    "AttachApiBedrockInvokePolicyCondition": {"Fn::Equals": [{"Ref": "AttachApiBedrockInvokePolicy"}, "true"]},
    "AttachBootstrapMasterKmsDecryptCondition": {"Fn::Equals": [{"Ref": "AttachBootstrapMasterKmsDecrypt"}, "true"]},
    "AttachBootstrapApplicationKmsDecryptCondition": {"Fn::Equals": [{"Ref": "AttachBootstrapApplicationKmsDecrypt"}, "true"]}
  },
  "Resources": {
    "BootstrapTaskRole": {"Condition": "CreateBootstrapTaskRoleCondition", "Type": "AWS::IAM::Role", "Properties": {"RoleName": {"Ref": "BootstrapTaskRoleName"}, "AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "ecs-tasks.amazonaws.com"}, "Action": "sts:AssumeRole"}]}, "Policies": [{"PolicyName": "novamind-rds-bootstrap-secrets", "PolicyDocument": {"Version": "2012-10-17", "Statement": [{"Sid": "ReadOnlyBootstrapSecrets", "Effect": "Allow", "Action": ["secretsmanager:GetSecretValue"], "Resource": [{"Ref": "RdsMasterSecretArn"}, {"Ref": "ApplicationSecretArn"}]}, {"Sid": "WriteOnlyApplicationConnectionSecret", "Effect": "Allow", "Action": ["secretsmanager:PutSecretValue"], "Resource": {"Ref": "ApplicationSecretArn"}}]}}]}},
    "BootstrapExecutionRole": {"Condition": "CreateBootstrapExecutionRoleCondition", "Type": "AWS::IAM::Role", "Properties": {"RoleName": {"Ref": "BootstrapExecutionRoleName"}, "AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "ecs-tasks.amazonaws.com"}, "Action": "sts:AssumeRole"}]}, "Policies": [{"PolicyName": "novamind-crp-bootstrap-execution-dev", "PolicyDocument": {"Version": "2012-10-17", "Statement": [{"Sid": "GetEcrAuthorizationToken", "Effect": "Allow", "Action": ["ecr:GetAuthorizationToken"], "Resource": "*"}, {"Sid": "PullBootstrapImage", "Effect": "Allow", "Action": ["ecr:BatchCheckLayerAvailability", "ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer"], "Resource": {"Ref": "BootstrapEcrRepositoryArn"}}, {"Sid": "WriteBootstrapLogs", "Effect": "Allow", "Action": ["logs:CreateLogStream", "logs:PutLogEvents"], "Resource": {"Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:${BootstrapLogGroupName}:*"}}]}}]}},
    "BootstrapLogGroup": {"Condition": "CreateBootstrapLogGroupCondition", "Type": "AWS::Logs::LogGroup", "DeletionPolicy": "Retain", "UpdateReplacePolicy": "Retain", "Properties": {"LogGroupName": {"Ref": "BootstrapLogGroupName"}, "RetentionInDays": {"Ref": "LogRetentionDays"}}},
    "BootstrapSecurityGroup": {"Condition": "CreateBootstrapSecurityGroupCondition", "Type": "AWS::EC2::SecurityGroup", "Properties": {"GroupName": {"Ref": "BootstrapSecurityGroupName"}, "GroupDescription": "One-shot NovaMind RDS bootstrap: no ingress, RDS PostgreSQL and approved HTTPS egress only.", "VpcId": {"Ref": "VpcId"}, "SecurityGroupEgress": [{"IpProtocol": "tcp", "FromPort": 5432, "ToPort": 5432, "DestinationSecurityGroupId": {"Ref": "RdsSecurityGroupId"}, "Description": "Private PostgreSQL bootstrap connection only"}, {"IpProtocol": "tcp", "FromPort": 443, "ToPort": 443, "CidrIp": "0.0.0.0/0", "Description": "Temporary bootstrap HTTPS only"}], "Tags": [{"Key": "Project", "Value": "novamind-crp"}, {"Key": "Environment", "Value": "dev"}, {"Key": "ManagedBy", "Value": "CloudFormation"}]}},
    "RdsIngressFromBootstrapSecurityGroup": {"Condition": "CreateBootstrapSecurityGroupCondition", "Type": "AWS::EC2::SecurityGroupIngress", "Properties": {"GroupId": {"Ref": "RdsSecurityGroupId"}, "IpProtocol": "tcp", "FromPort": 5432, "ToPort": 5432, "SourceSecurityGroupId": {"Ref": "BootstrapSecurityGroup"}, "Description": "One-shot NovaMind RDS bootstrap only"}},
    "ApiExecutionApplicationSecretPolicy": {"Condition": "AttachApiApplicationSecretReadPolicyCondition", "Type": "AWS::IAM::Policy", "Properties": {"PolicyName": "novamind-application-postgres-secret", "Roles": [{"Ref": "ApiExecutionRoleName"}], "PolicyDocument": {"Version": "2012-10-17", "Statement": [{"Sid": "InjectOnlyNovaMindApplicationPostgresSecret", "Effect": "Allow", "Action": ["secretsmanager:GetSecretValue"], "Resource": {"Ref": "ApplicationSecretArn"}}]}}},
    "ApiTaskBedrockPolicy": {"Condition": "AttachApiBedrockInvokePolicyCondition", "Type": "AWS::IAM::Policy", "Properties": {"PolicyName": "novamind-crp-nova-lite-bedrock-invoke", "Roles": [{"Ref": "ApiTaskRoleName"}], "PolicyDocument": {"Version": "2012-10-17", "Statement": [{"Sid": "InvokeNovaMindCrpNovaLite", "Effect": "Allow", "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"], "Resource": [{"Fn::Sub": "arn:${AWS::Partition}:bedrock:us-east-1:${AWS::AccountId}:inference-profile/us.amazon.nova-lite-v1:0"}, {"Fn::Sub": "arn:${AWS::Partition}:bedrock:us-east-1::foundation-model/amazon.nova-lite-v1:0"}, {"Fn::Sub": "arn:${AWS::Partition}:bedrock:us-east-2::foundation-model/amazon.nova-lite-v1:0"}, {"Fn::Sub": "arn:${AWS::Partition}:bedrock:us-west-2::foundation-model/amazon.nova-lite-v1:0"}]}]}}},
    "BootstrapMasterKmsPolicy": {"Condition": "AttachBootstrapMasterKmsDecryptCondition", "Type": "AWS::IAM::Policy", "Properties": {"PolicyName": "novamind-bootstrap-master-kms", "Roles": [{"Fn::If": ["CreateBootstrapTaskRoleCondition", {"Ref": "BootstrapTaskRole"}, {"Ref": "ExistingBootstrapTaskRoleName"}]}], "PolicyDocument": {"Version": "2012-10-17", "Statement": [{"Sid": "DecryptMasterOnlyThroughSecretsManager", "Effect": "Allow", "Action": ["kms:Decrypt"], "Resource": {"Ref": "MasterSecretKmsKeyArn"}, "Condition": {"StringEquals": {"kms:ViaService": {"Fn::Sub": "secretsmanager.${AWS::Region}.amazonaws.com"}}}}]}}},
    "BootstrapApplicationKmsPolicy": {"Condition": "AttachBootstrapApplicationKmsDecryptCondition", "Type": "AWS::IAM::Policy", "Properties": {"PolicyName": "novamind-bootstrap-application-kms", "Roles": [{"Fn::If": ["CreateBootstrapTaskRoleCondition", {"Ref": "BootstrapTaskRole"}, {"Ref": "ExistingBootstrapTaskRoleName"}]}], "PolicyDocument": {"Version": "2012-10-17", "Statement": [{"Sid": "DecryptApplicationOnlyThroughSecretsManager", "Effect": "Allow", "Action": ["kms:Decrypt"], "Resource": {"Ref": "ApplicationSecretKmsKeyArn"}, "Condition": {"StringEquals": {"kms:ViaService": {"Fn::Sub": "secretsmanager.${AWS::Region}.amazonaws.com"}}}}]}}}
  },
  "Outputs": {
    "BootstrapTaskRoleArn": {"Value": {"Fn::If": ["CreateBootstrapTaskRoleCondition", {"Fn::GetAtt": ["BootstrapTaskRole", "Arn"]}, {"Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/${ExistingBootstrapTaskRoleName}"}]}},
    "BootstrapExecutionRoleArn": {"Value": {"Fn::If": ["CreateBootstrapExecutionRoleCondition", {"Fn::GetAtt": ["BootstrapExecutionRole", "Arn"]}, {"Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/${ExistingBootstrapExecutionRoleName}"}]}, "Export": {"Name": {"Fn::Sub": "${AWS::StackName}-BootstrapExecutionRoleArn"}}},
    "BootstrapLogGroupName": {"Value": {"Ref": "BootstrapLogGroupName"}},
    "BootstrapSecurityGroupId": {"Condition": "CreateBootstrapSecurityGroupCondition", "Value": {"Ref": "BootstrapSecurityGroup"}}
  }
}
