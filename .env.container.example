# Optional: copy to .env for docker compose. No credentials belong here.
NOVAMIND_PORT=8080
# For compose.auth.yaml only, set a host path in your shell:
# NOVAMIND_AUTH_SOURCE=C:/private/novamind-auth.json
# Optional compose.bedrock.yaml: set AWS_REGION and BEDROCK_MODEL_ID in the
# invoking process. Supply AWS credentials through a standard runtime provider;
# do not put credentials in this file or frontend/build configuration.
# Optional AUTO overlay: add compose.auto.yaml and set
# NOVAMIND_DISPATCHER_USER_ID in the invoking environment to a canonical staff
# UUID present in the configured local auth file. AUTO remains MANUAL until an
# ADMIN explicitly changes the persistent control setting.
