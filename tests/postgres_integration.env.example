# Dedicated, empty, disposable PostgreSQL database only.  Never point this at
# a shared, development, staging, or production database.  The integration
# suite refuses any database name other than novamind_phase_c_test or a
# novamind_phase_c_test_<suffix> variant, then replaces its public schema.
#
# Supply credentials outside this file (for example through your CI secret
# store).  This value is intentionally credential-free.
NOVAMIND_POSTGRES_TEST_DSN=postgresql://novamind_test@127.0.0.1:5432/novamind_phase_c_test
